diff --git a/prisma/migrations/20260910120000_project_publishing_transactions/migration.sql b/prisma/migrations/20260910120000_project_publishing_transactions/migration.sql
new file mode 100644
index 0000000..6676315
--- /dev/null
+++ b/prisma/migrations/20260910120000_project_publishing_transactions/migration.sql
@@ -0,0 +1,49 @@
+-- AlterTable
+ALTER TABLE `projects` ADD COLUMN `aiAnalysis` JSON NULL,
+    ADD COLUMN `area` DOUBLE NULL,
+    ADD COLUMN `description` TEXT NULL,
+    ADD COLUMN `duration` INTEGER NULL,
+    ADD COLUMN `fragments` INTEGER NULL,
+    ADD COLUMN `fundingTarget` DECIMAL(14, 2) NULL,
+    ADD COLUMN `milestoneVersion` INTEGER NOT NULL DEFAULT 0,
+    ADD COLUMN `milestones` JSON NULL,
+    ADD COLUMN `progressNote` TEXT NULL,
+    ADD COLUMN `species` VARCHAR(191) NULL;
+
+-- CreateTable
+CREATE TABLE `transactions` (
+    `id` VARCHAR(36) NOT NULL,
+    `investor_id` INTEGER NOT NULL,
+    `project_id` INTEGER NOT NULL,
+    `amount` DECIMAL(12, 2) NOT NULL,
+    `status` VARCHAR(20) NOT NULL DEFAULT 'Pending',
+    `proof_file` VARCHAR(191) NULL,
+    `idempotency_key` VARCHAR(100) NOT NULL,
+    `review_note` TEXT NULL,
+    `reviewed_by` INTEGER NULL,
+    `reviewed_at` DATETIME(3) NULL,
+    `created_at` DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
+
+    UNIQUE INDEX `transactions_idempotency_key_key`(`idempotency_key`),
+    INDEX `transactions_investor_id_created_at_idx`(`investor_id`, `created_at`),
+    INDEX `transactions_project_id_status_idx`(`project_id`, `status`),
+    PRIMARY KEY (`id`)
+) DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
+
+-- CreateTable
+CREATE TABLE `payment_settings` (
+    `id` INTEGER NOT NULL DEFAULT 1,
+    `bankName` VARCHAR(100) NOT NULL,
+    `accountNumber` VARCHAR(100) NOT NULL,
+    `accountHolder` VARCHAR(191) NOT NULL,
+    `updatedAt` DATETIME(3) NOT NULL,
+
+    PRIMARY KEY (`id`)
+) DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
+
+-- AddForeignKey
+ALTER TABLE `transactions` ADD CONSTRAINT `transactions_investor_id_fkey` FOREIGN KEY (`investor_id`) REFERENCES `users`(`id`) ON DELETE RESTRICT ON UPDATE CASCADE;
+
+-- AddForeignKey
+ALTER TABLE `transactions` ADD CONSTRAINT `transactions_project_id_fkey` FOREIGN KEY (`project_id`) REFERENCES `projects`(`id`) ON DELETE RESTRICT ON UPDATE CASCADE;
+
diff --git a/prisma/migrations/20260910130000_frontend_profile_fields/migration.sql b/prisma/migrations/20260910130000_frontend_profile_fields/migration.sql
new file mode 100644
index 0000000..e60a45a
--- /dev/null
+++ b/prisma/migrations/20260910130000_frontend_profile_fields/migration.sql
@@ -0,0 +1,8 @@
+-- AlterTable
+ALTER TABLE `users` ADD COLUMN `phone` VARCHAR(30) NULL;
+
+-- AlterTable
+ALTER TABLE `transactions` ADD COLUMN `contributorEmail` VARCHAR(191) NULL,
+    ADD COLUMN `contributorName` VARCHAR(191) NULL,
+    ADD COLUMN `type` VARCHAR(50) NOT NULL DEFAULT 'One-Time Contribution';
+
diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index 98bc15e..ed4b39a 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -26,6 +26,7 @@ model User {
   nama      String
   email     String   @unique
   password  String
+  phone     String? @db.VarChar(30)
   role      Role     @default(investor)
   createdAt DateTime @default(now()) @map("created_at")
 
@@ -33,6 +34,7 @@ model User {
   projects  Project[]   @relation("AdminProjects")
   // Relasi: investor melakukan banyak donasi
   donations Donation[]
+  transactions Transaction[]
 
   @@map("users")
 }
@@ -50,8 +52,20 @@ model Project {
   statusVerifikasi  StatusVerifikasi  @default(pending) @map("status_verifikasi")
   createdAt         DateTime          @default(now()) @map("created_at")
 
+  description       String? @db.Text
+  species           String?
+  fundingTarget     Decimal? @db.Decimal(14, 2)
+  duration          Int?
+  fragments         Int?
+  area              Float?
+  milestones        Json?
+  milestoneVersion  Int @default(0)
+  progressNote      String? @db.Text
+  aiAnalysis        Json?
+
   admin     User       @relation("AdminProjects", fields: [adminId], references: [id])
   donations Donation[]
+  transactions Transaction[]
 
   @@map("projects")
 }
@@ -69,3 +83,34 @@ model Donation {
 
   @@map("donations")
 }
+
+model Transaction {
+  id String @id @default(uuid()) @db.VarChar(36)
+  investorId Int @map("investor_id")
+  projectId Int @map("project_id")
+  amount Decimal @db.Decimal(12, 2)
+  type String @default("One-Time Contribution") @db.VarChar(50)
+  contributorName String? @db.VarChar(191)
+  contributorEmail String? @db.VarChar(191)
+  status String @default("Pending") @db.VarChar(20)
+  proofFile String? @map("proof_file")
+  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(100)
+  reviewNote String? @map("review_note") @db.Text
+  reviewedBy Int? @map("reviewed_by")
+  reviewedAt DateTime? @map("reviewed_at")
+  createdAt DateTime @default(now()) @map("created_at")
+  investor User @relation(fields: [investorId], references: [id])
+  project Project @relation(fields: [projectId], references: [id])
+  @@index([investorId, createdAt])
+  @@index([projectId, status])
+  @@map("transactions")
+}
+
+model PaymentSettings {
+  id Int @id @default(1)
+  bankName String @db.VarChar(100)
+  accountNumber String @db.VarChar(100)
+  accountHolder String @db.VarChar(191)
+  updatedAt DateTime @updatedAt
+  @@map("payment_settings")
+}
